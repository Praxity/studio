{
	"name": "@praxity/export-pipeline",
	"version": "0.1.0",
	"private": true,
	"license": "SEE LICENSE IN LICENSE",
	"type": "module",
	"exports": {
		".": "./src/build.ts",
		"./artifact-media-types": "./src/artifact-media-types.ts",
		"./bundle-viewer": "./src/bundle-viewer.ts",
		"./glossary-page": "./src/glossary-page.ts",
		"./scorm12-storage": "./src/scorm/scorm12-storage.ts",
		"./generate-color-shades": "./src/generate-color-shades.ts"
	},
	"scripts": {
		"test": "vitest run",
		"test:a11y": "playwright test --config=tests/a11y/playwright.config.ts",
		"test:deck": "playwright test --config=tests/deck/playwright.config.ts",
		"test:scorm-adl": "vitest run tests/adl-conformance.test.ts tests/scorm-runtime-contract.test.ts",
		"test:adl-manifest": "vitest run tests/adl-manifest.test.ts tests/adl-manifest-validator.test.ts",
		"test:scorm-cloud": "playwright test --config=tests/scorm-cloud/playwright.config.ts",
		"test:scorm-local": "playwright test --config=tests/scorm-local/playwright.config.ts",
		"typecheck": "tsc --noEmit",
		"adl:intake": "node scripts/adl-resource-intake.mjs",
		"prebuild:client": "tsx src/prebuild-client.ts",
		"prebuild": "pnpm prebuild:client"
	},
	"dependencies": {
		"@fontsource/atkinson-hyperlegible-next": "^5.3.0",
		"@fontsource/source-sans-3": "^5.2.9",
		"@fontsource/source-serif-4": "^5.3.0",
		"@jsquash/jpeg": "1.6.0",
		"@jsquash/png": "3.1.1",
		"@jsquash/webp": "1.5.0",
		"@mantine/core": "^9.0.0",
		"@mantine/hooks": "^9.0.0",
		"@praxity/grammar": "workspace:*",
		"@praxity/shared-blocks": "workspace:*",
		"@tabler/icons": "^3.46.0",
		"archiver": "^8.0.0",
		"esbuild": "^0.28.2",
		"fflate": "0.8.3",
		"fs-extra": "^11.3.4",
		"learning-patterns": "catalog:",
		"perfect-arrows": "^0.3.7",
		"pica": "9.0.1",
		"prism-react-renderer": "^2.4.1",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"rough-notation": "^0.5.1"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.11.1",
		"@playwright/test": "^1.59.0",
		"@types/adm-zip": "^0.5.8",
		"@types/archiver": "^8.0.0",
		"@types/fs-extra": "^11.0.0",
		"@types/jsdom": "^27.0.0",
		"@types/pica": "9.0.5",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"adm-zip": "^0.6.1",
		"dom-accessibility-api": "0.6.3",
		"jsdom": "^30.0.1",
		"lightningcss": "1.33.0",
		"serve-handler": "^6.1.6",
		"typescript": "^5.7.0",
		"vitest": "^4.1.12"
	}
}
