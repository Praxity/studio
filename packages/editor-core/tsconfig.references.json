{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"composite": true,
		"declaration": true,
		"declarationMap": true,
		"emitDeclarationOnly": true,
		"outDir": "dist/types"
	},
	"include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.json"],
	"exclude": [
		"node_modules",
		"dist",
		"src/**/*.test.ts",
		"src/**/*.test.tsx",
		"src/**/__tests__/**"
	]
}
